# ---------------------------------------------------------------------------
# Lab Vibes London — pipeline configuration
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Local LLM (Ollama) -----------------------------------------------------
# Raw text is ONLY ever sent to this local endpoint. Never to a cloud model,
# a GitHub Action, or the browser.
OLLAMA_HOST=http://localhost:11434

# Model used for summarisation. Must handle Chinese and English well.
# Default is a Qwen instruct model. Override to any locally pulled model.
LABVIBES_MODEL=qwen2.5:7b-instruct

# --- Anonymisation ----------------------------------------------------------
# Secret salt used when hashing post/comment/author identifiers.
# CHANGE THIS to a long random value and keep it out of version control.
# Losing it only breaks cross-run identifier matching; it is not recoverable.
LABVIBES_HASH_SALT=change-me-to-a-long-random-secret

# --- Publication thresholds -------------------------------------------------
# Minimum evidence required before a lab-level summary may be published.
LABVIBES_MIN_ITEMS=5
LABVIBES_MIN_AUTHORS=3

# --- Paths (relative to repo root) ------------------------------------------
LABVIBES_DATA_DIR=data
LABVIBES_WEB_PUBLIC_DIR=web/public/data

# --- LLM inference tuning ---------------------------------------------------
LABVIBES_TEMPERATURE=0
LABVIBES_SEED=7
LABVIBES_MAX_RETRIES=3
LABVIBES_REQUEST_TIMEOUT=120
